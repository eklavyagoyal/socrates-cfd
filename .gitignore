__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
# Generated OpenFOAM data: regenerable from case_config.json + OpenFOAM version.
results/runs/*/case/constant/polyMesh/
results/runs/*/case/[1-9]*/
results/runs/*/case/0.*/
results/runs/*/case/log.*
results/runs/*/case/postProcessing/
results/runs/*/case/processor*/
results/runs/*/_gen/
# raw solver logs are large; their sha256 is in run.json, compressed copies kept locally
results/runs/*/log.pimpleFoam*.gz
results/runs/*/log.simpleFoam*.gz
